// VideoMax MBA — database schema.
//
// F02 (Authentication System) bootstraps this file with the two tables every
// later feature builds on. Column names are snake_cased via `@map` so the SQL
// stays idiomatic while the TypeScript client stays camelCase.

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  name         String    @db.VarChar(120)
  email        String    @unique(map: "ux_user_email") @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  /// Gates `/admin/*` (F12). Added now so F12 ships without a migration.
  isAdmin      Boolean   @default(false) @map("is_admin")
  /// Blocks login (F12). Flipping it should also delete the user's sessions.
  isSuspended  Boolean   @default(false) @map("is_suspended")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions     Session[]
  videos       Video[]

  @@map("user")
}

model Session {
  /// Opaque base64url-encoded 32 random bytes; this is the cookie value.
  id                String   @id @db.VarChar(64)
  userId            String   @map("user_id")
  /// Sliding expiry, pushed forward on authenticated reads.
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(6)
  /// Hard cap; the session dies here no matter how often it was refreshed.
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_session_user")

  @@index([userId], map: "ix_session_user_id")
  @@index([expiresAt], map: "ix_session_expires_at")
  @@map("session")
}

/// One uploaded video (F03). Later features hang their own tables off `id`.
model Video {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  title            String   @db.VarChar(200)
  description      String   @default("") @db.VarChar(2000)
  originalFilename String   @map("original_filename") @db.VarChar(255)
  sizeBytes        BigInt   @map("size_bytes")
  /// Null when ffprobe could not read the file; F07's validate stage fails it.
  durationSeconds  Decimal? @map("duration_seconds") @db.Decimal(10, 3)
  /// Lowercased extension without the dot: mp4, mov, mkv, webm, avi.
  containerFormat  String   @map("container_format") @db.VarChar(8)
  /// Relative to VIDEO_STORAGE_ROOT, so the root can move without a rewrite.
  storagePath      String   @map("storage_path") @db.VarChar(512)
  /// Relative to VIDEO_STORAGE_ROOT; null means "serve the placeholder".
  thumbnailPath    String?  @map("thumbnail_path") @db.VarChar(512)
  /// varchar + CHECK rather than a native enum, so F07 can add a stage
  /// without a migration. Values live in `app/_lib/videos/status.ts`.
  status           String   @default("validating") @db.VarChar(16)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_video_user")

  @@index([userId, createdAt(sort: Desc)], map: "ix_video_user_id_created_at")
  @@index([status], map: "ix_video_status")
  @@map("video")
}
