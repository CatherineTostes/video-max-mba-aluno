# Copy this file to `.env.local` and fill in the values.
#
# `.env.local` is read automatically by `next dev`/`next build` and by the
# Prisma CLI (see `prisma7.config.ts`).

# F02 — Authentication System.

# Postgres connection string. Matches the `docker-compose.yml` service, which
# publishes the container's 5432 on host port 5433 to avoid colliding with a
# pre-existing local Postgres.
DATABASE_URL="postgresql://videomax:videomax@localhost:5433/videomax?schema=public"

# Secret used to sign the `videomax_session` cookie. Must be at least 32
# characters. Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-to-at-least-32-random-characters"

# F03 — Video Upload.

# Where uploaded videos and their thumbnails are stored. Relative paths resolve
# against the project root; the default is gitignored.
VIDEO_STORAGE_ROOT="storage/videos"

# Per-file upload cap in bytes. 2147483648 = 2 GiB, the PRD limit.
VIDEO_MAX_BYTES="2147483648"
